# Optional providers (Adzuna + an LLM planner)

# Nothing here is required. With no keys the app runs the seeded listings and the
# deterministic planner, and behaves identically otherwise.
#
# Copy to apps/api/.env and fill in whichever you have. Real environment variables
# always win over this file.

# ---- Job listings (Adzuna) ----
# Register: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# auto (default) | mock | adzuna
PLACEPILOT_JOBS=auto

# ---- LLM planner ----
# Easiest: an OpenRouter key (one key, many models)
OPENROUTER_API_KEY=
# Or a native Anthropic key
ANTHROPIC_API_KEY=
# auto (default) | off | anthropic | openrouter
PLACEPILOT_LLM=auto
# e.g. anthropic/claude-sonnet-4.5 on OpenRouter, or claude-sonnet-4-5 on Anthropic
# PLACEPILOT_MODEL=

# ---- Local ----
# PLACEPILOT_DB=apps/api/data/placepilot.db
# PLACEPILOT_DEMO=1
